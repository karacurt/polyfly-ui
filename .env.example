# Optional. When set, GET /api/snapshot fetches this URL instead of the local demo seed.
# Expected JSON: a polyfly worker snapshot (same shape as public/demo/latest.json)
# or a combined payload that already includes `events` and `chart_url`.
# SNAPSHOT_URL=https://your-worker.example/snapshot

# Demo-only. Cycle through public/demo/events.jsonl so the UI looks alive.
# Set to 0 to always serve the latest seed tick.
# DEMO_REPLAY=1
