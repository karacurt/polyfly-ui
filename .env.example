# Public Polygon wallet to display (no key, no trading).
# Default if unset: 0x6eA65CEf2FF7c8dfB3Ad59C6FACD32eA45f7744d
# WALLET_ADDRESS=0x6eA65CEf2FF7c8dfB3Ad59C6FACD32eA45f7744d

# 1 = fetch on-chain + Polymarket Data API into /api/snapshot (default on).
# 0 = paper/demo portfolio only.
# LIVE_WALLET=1

# Scoreboard baselines for P&L %. Wallet default 10 (current ~10 pUSD).
# Fly default: seed initial cash / first event (5) or PAPER_START_USD.
# WALLET_START_USD=10
# PAPER_START_USD=5

# Optional Polygon JSON-RPC. Falls back to publicnode.
# POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# Cost basis (USDC.e) for the open WETH scalp P&L. Default 2.8.
# WETH_COST_USDCE=2.8

# Optional. When set, GET /api/snapshot fetches this URL instead of the local demo seed.
# Expected JSON: a polyfly / fly-brain worker snapshot (same shape as public/demo/latest.json)
# or a combined payload with events, chart_url, and consciousness / consciousness_* fields.
# SNAPSHOT_URL=https://your-worker.example/snapshot

# Demo-only. Cycle through public/demo/events.jsonl so the neural panel looks alive.
# Set to 0 to always serve the latest seed tick.
# DEMO_REPLAY=1
